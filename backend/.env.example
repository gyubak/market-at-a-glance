# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git 에 커밋되지 않습니다)
# ⚠️ 실제 키/시크릿은 절대 .env.example 에 넣지 마세요 — placeholder 만 유지.

# ── 한국투자증권 (KIS) ───────────────────────────────
# 시세/투자자매매동향/금리 조회는 "실전(실계좌)" 도메인에서만 동작합니다.
# 키가 없으면 코스피/코스닥/국채/투자자매매동향은 표시되지 않습니다(해외는 키 불필요).
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_REST_BASE=https://openapi.koreainvestment.com:9443
KIS_CUSTTYPE=P                  # P: 개인, B: 법인
KIS_MIN_INTERVAL_SEC=0.45       # KIS 호출 간 최소 간격(초). "초당 거래건수 초과" 나면 늘리세요
KIS_FLOW_UNIT_DIV=100           # 투자자매매동향 tr_pbmn → 억원 환산 (백만원 기준 100)

# 코스피/코스닥:
#   - 비워두면 업종 지수 분봉(정규장만)
#   - 지수선물 근월물 코드를 넣으면 선물로 전환. 주간(F)→야간(CM) 자동 전환.
#     예) KOSPI200 선물 = A01609, 코스닥150 선물 = A06609  (만기마다 갱신 필요)
KIS_KOSPI_FUT_CODE=
KIS_KOSDAQ_FUT_CODE=

# 국고채 3년: 금리종합 API(HHPST070200C0)에서 자동 조회 — 별도 코드 불필요.

# ── 해외 5종 (나스닥 선물 / WTI / 달러 인덱스 / 원달러 / 미국채 2년) ──
# 소스: tv(TradingView 비공식 소켓, 실시간에 가까움) | yahoo(선물 ~10분 지연)
#   기본값: 나스닥/WTI/DXY/미국채2년 = tv,  원달러 = yahoo
# SOURCE_NASDAQ_FUT=tv
# SOURCE_WTI=tv
# SOURCE_DXY=tv
# SOURCE_UST2Y=tv
# SOURCE_USDKRW=yahoo
#
# TradingView 심볼 override (기본: OANDA:NAS100USD / TVC:USOIL / TVC:DXY / FX_IDC:USDKRW / TVC:US02Y)
#   나스닥은 TVC:NDX(지수)가 야간에 비어서 24h CFD 를 씀
# TV_SYMBOL_NASDAQ_FUT=OANDA:NAS100USD
# TV_SYMBOL_WTI=TVC:USOIL
# TV_SYMBOL_DXY=TVC:DXY
# TV_SYMBOL_UST2Y=TVC:US02Y
#
# yahoo 티커 override (SOURCE_*=yahoo 일 때)
# YAHOO_TICKER_USDKRW=KRW=X

# ── 서버 ────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
POLL_YAHOO_SEC=6              # yahoo 폴링 주기(초)
POLL_DOMESTIC_SEC=5
TV_RECONNECT_SEC=5           # TradingView 소켓 재연결 대기(초)
STALE_AFTER_SEC=10           # 개장 중 이 시간 이상 미수신이면 빨간불
